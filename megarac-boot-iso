#!/bin/bash
# megarac-boot-iso - make an AMI MegaRAC BMC boot a host off an EFI binary by
# serving it as an NFS-backed virtual CD.
#
# Three modes:
#   --iso FILE      attach an already-built ISO (no build tools needed, just curl)
#   --build-only    build the ISO from an EFI binary and stop (no BMC contact)
#   (default)       build from --efi, then attach
#
# The BMC mounts the ISO over NFS and presents it to the host as a virtual
# CD-ROM, so a server whose firmware has no usable network bootloader can still
# be made to boot an arbitrary aarch64 (or x86) EFI binary. Powering the host on
# and selecting the CD as the boot device is left to the caller (IPMI
# `chassis bootdev cdrom options=efiboot` + power on, or the BMC UI).
#
# Under LAVA this is meant to run as a `deploy: to: flasher` command: the job
# downloads a prebuilt ISO into the flasher directory (which lives in the
# NFS-exported tree) and the device dictionary supplies --bmc-host, so one
# health check works unchanged on every board of a device type.
#
# Dependencies: bash, curl, coreutils; plus mtools and xorriso when building.
#
# SPDX-License-Identifier: MIT

set -euo pipefail

# BMC_HOST / BMC_USER / BMC_PASS may be supplied in the environment and are
# overridden by the matching flags. Credentials default to admin/admin.
BMC_HOST="${BMC_HOST:-}"
BMC_USER="${BMC_USER:-admin}"
BMC_PASS="${BMC_PASS:-admin}"
NFS_SERVER=""
NFS_PATH=""
OUT_DIR=""
# --image-name / --efi / --iso may also come from the environment; --efi, if
# still unset in a build, auto-detects a single *.efi in the output directory.
IMAGE_NAME="${MEGARAC_IMAGE_NAME:-boot.iso}"
EFI_FILE="${MEGARAC_EFI:-}"
ISO_FILE="${MEGARAC_ISO:-}"
GRUB_CFG=""
VOLUME_ID="BOOTISO"
SLACK_MIB="2"
BUILD_ONLY=0
WAIT_READY=0
NAMESPACE="${LAVA_NAMESPACE:-common}"
DISPATCHER_TMP="${DISPATCHER_TMP:-/var/lib/lava/dispatcher/tmp}"
LAVA_DOWNLOADS_MOUNT="/lava-downloads"

usage() {
    cat >&2 <<EOF
usage: megarac-boot-iso --iso FILE --bmc-host HOST [options]
       megarac-boot-iso --efi FILE --build-only [options]
       megarac-boot-iso --efi FILE --bmc-host HOST [options]

Attach a bootable ISO to an AMI MegaRAC BMC as an NFS virtual CD, building the
ISO from an EFI binary first unless one is supplied with --iso.

Mode:
  --iso FILE             attach this already-built ISO; no build tools needed.
                         Its directory is what the BMC is pointed at, and its
                         basename is the image name. (or \$MEGARAC_ISO)
  --build-only           build the ISO and exit without touching the BMC
  --efi FILE             EFI binary to build from (becomes EFI/BOOT/BOOTAA64.EFI).
                         (or \$MEGARAC_EFI; otherwise a single *.efi in --out-dir)

BMC (not needed with --build-only):
  --bmc-host HOST        BMC address (or \$BMC_HOST)
  --bmc-user USER        default admin (or \$BMC_USER)
  --bmc-pass PASS        default admin (or \$BMC_PASS)
  --wait-ready SECONDS   keep retrying the login for this long before giving up,
                         for a BMC that is still coming up (default 0, one try)

NFS share the BMC mounts:
  --nfs-server IP        address the BMC mounts from (or \$LAVA_DISPATCHER_IP)
  --nfs-path PATH        host path of the directory holding the ISO. Defaults to
                         the real path of --out-dir, except inside a LAVA
                         downloads postprocess (where the working directory is a
                         bind mount), when it is derived from \$LAVA_JOB_ID.
  --out-dir DIR          where the ISO is written/read (default: . , or the
                         directory of --iso)
  --image-name NAME      ISO filename when building (default: boot.iso, or
                         \$MEGARAC_IMAGE_NAME)

Build options:
  --grub-cfg FILE        use this grub.cfg instead of the built-in menu
  --volume-id ID         ISO/FAT volume label (default: BOOTISO)
  --slack-mib N          spare space in the FAT image, MiB (default: 2)
EOF
    exit "${1:-2}"
}

log() { echo "megarac-boot-iso: $*"; }
die() { echo "megarac-boot-iso: error: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case "$1" in
        --iso)           ISO_FILE="$2"; shift 2 ;;
        --build-only)    BUILD_ONLY=1; shift ;;
        --efi)           EFI_FILE="$2"; shift 2 ;;
        --bmc-host)      BMC_HOST="$2"; shift 2 ;;
        --bmc-user)      BMC_USER="$2"; shift 2 ;;
        --bmc-pass)      BMC_PASS="$2"; shift 2 ;;
        --wait-ready)    WAIT_READY="$2"; shift 2 ;;
        --nfs-server)    NFS_SERVER="$2"; shift 2 ;;
        --nfs-path)      NFS_PATH="$2"; shift 2 ;;
        --out-dir)       OUT_DIR="$2"; shift 2 ;;
        --image-name)    IMAGE_NAME="$2"; shift 2 ;;
        --grub-cfg)      GRUB_CFG="$2"; shift 2 ;;
        --volume-id)     VOLUME_ID="$2"; shift 2 ;;
        --slack-mib)     SLACK_MIB="$2"; shift 2 ;;
        --namespace)     NAMESPACE="$2"; shift 2 ;;
        -h|--help)       usage 0 ;;
        *)               echo "unknown argument: $1" >&2; usage ;;
    esac
done

# --- work out what we are attaching, and from where -------------------------
if [ -n "$ISO_FILE" ]; then
    [ -f "$ISO_FILE" ] || die "ISO not found: $ISO_FILE"
    [ -n "$OUT_DIR" ] || OUT_DIR="$(dirname "$ISO_FILE")"
    IMAGE_NAME="$(basename "$ISO_FILE")"
fi
[ -n "$OUT_DIR" ] || OUT_DIR="."
mkdir -p "$OUT_DIR"

# The BMC mounts a path on the host, which is not always the path we see: in a
# LAVA downloads postprocess the working directory is a bind mount of the real
# download directory, so derive the host path from the job id instead.
ABS_OUT="$(cd "$OUT_DIR" && pwd -P)"
if [ -z "$NFS_PATH" ]; then
    case "$ABS_OUT" in
        "$LAVA_DOWNLOADS_MOUNT"|"$LAVA_DOWNLOADS_MOUNT"/*)
            [ -n "${LAVA_JOB_ID:-}" ] || die "running under $LAVA_DOWNLOADS_MOUNT but \$LAVA_JOB_ID is unset; pass --nfs-path"
            NFS_PATH="${DISPATCHER_TMP}/${LAVA_DISPATCHER_PREFIX:-}${LAVA_JOB_ID}/downloads/${NAMESPACE}${ABS_OUT#$LAVA_DOWNLOADS_MOUNT}"
            ;;
        *)  NFS_PATH="$ABS_OUT" ;;
    esac
fi
[ -n "$NFS_SERVER" ] || NFS_SERVER="${LAVA_DISPATCHER_IP:-}"

ISO_PATH="$OUT_DIR/$IMAGE_NAME"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# --- build the bootable ISO (unless one was supplied) -----------------------
if [ -z "$ISO_FILE" ]; then
    # If no EFI was given, auto-detect a single *.efi in the output directory.
    if [ -z "$EFI_FILE" ]; then
        shopt -s nullglob nocaseglob
        efis=("$OUT_DIR"/*.efi)
        shopt -u nullglob nocaseglob
        case "${#efis[@]}" in
            1) EFI_FILE="${efis[0]}" ;;
            0) die "no --iso, no --efi, no \$MEGARAC_EFI, and no *.efi found in $OUT_DIR" ;;
            *) die "no --efi given and several *.efi in $OUT_DIR (${efis[*]}); set --efi" ;;
        esac
    fi
    [ -f "$EFI_FILE" ] || die "EFI file not found: $EFI_FILE"

    for tool in mformat mmd mcopy xorriso; do
        command -v "$tool" >/dev/null 2>&1 || die "missing build dependency: $tool"
    done

    # A GRUB loaded from CD needs a config to present a menu. Use the caller's if
    # given, otherwise embed a small one: a 30s timeout so the test harness can
    # interrupt the menu and drop to the GRUB command line. If nobody
    # interrupts, it returns to firmware (normal boot order).
    if [ -z "$GRUB_CFG" ]; then
        GRUB_CFG="$WORK/grub.cfg"
        cat > "$GRUB_CFG" <<EOF
set timeout=30
terminal_input console
terminal_output console
menuentry "megarac-boot-iso: waiting for the test harness (exit to firmware)" {
    echo "Menu was not interrupted; returning to firmware."
    exit
}
EOF
    else
        [ -f "$GRUB_CFG" ] || die "grub.cfg not found: $GRUB_CFG"
    fi

    # The El Torito EFI boot image must itself be a FAT filesystem (UEFI spec); a
    # raw PE binary is rejected by strict firmware. It must be FAT16: AMI Aptio
    # firmware boots that, and can refuse FAT12/FAT32. With 2 sectors/cluster the
    # cluster count stays in FAT16 range (4085..65524) for images from ~4MiB to
    # ~64MiB, which covers any realistic GRUB; the check below enforces it, since
    # mtools silently picks FAT12 for a small image and FAT32 for a large one.
    EFI_BYTES="$(stat -c%s "$EFI_FILE")"
    IMG_KIB=$(( (EFI_BYTES / 1024) + SLACK_MIB * 1024 ))
    IMG_KIB=$(( ((IMG_KIB + 1023) / 1024) * 1024 ))     # round up to a whole MiB

    mkdir -p "$WORK/iso"
    dd if=/dev/zero of="$WORK/iso/efiboot.img" bs=1024 count="$IMG_KIB" status=none
    mformat -i "$WORK/iso/efiboot.img" -c 2 -v "$VOLUME_ID" ::
    fat_type="$(dd if="$WORK/iso/efiboot.img" bs=1 skip=54 count=8 2>/dev/null)"
    case "$fat_type" in
        FAT16*) ;;
        *) die "built a ${fat_type% *} boot image, need FAT16 (adjust --slack-mib)" ;;
    esac
    mmd -i "$WORK/iso/efiboot.img" ::/EFI ::/EFI/BOOT ::/boot ::/boot/grub
    mcopy -i "$WORK/iso/efiboot.img" "$EFI_FILE" ::/EFI/BOOT/BOOTAA64.EFI
    # Place the config where a CD-loaded GRUB looks: next to the binary, and the
    # conventional /boot/grub. Also drop it in the ISO9660 tree for good measure.
    mcopy -i "$WORK/iso/efiboot.img" "$GRUB_CFG" ::/boot/grub/grub.cfg
    mcopy -i "$WORK/iso/efiboot.img" "$GRUB_CFG" ::/EFI/BOOT/grub.cfg
    mkdir -p "$WORK/iso/boot/grub" "$WORK/iso/EFI/BOOT"
    cp "$GRUB_CFG" "$WORK/iso/boot/grub/grub.cfg"
    cp "$GRUB_CFG" "$WORK/iso/EFI/BOOT/grub.cfg"

    xorriso -as mkisofs -R -J -V "$VOLUME_ID" \
        -e efiboot.img -no-emul-boot \
        -o "$WORK/$IMAGE_NAME" "$WORK/iso" >/dev/null 2>&1

    # Install atomically so the BMC never reads a half-written ISO.
    cp "$WORK/$IMAGE_NAME" "$OUT_DIR/.$IMAGE_NAME.tmp"
    mv "$OUT_DIR/.$IMAGE_NAME.tmp" "$ISO_PATH"
    log "built $ISO_PATH ($(stat -c%s "$ISO_PATH") bytes) from $EFI_FILE"
fi

if [ "$BUILD_ONLY" = 1 ]; then
    log "--build-only: not touching a BMC"
    exit 0
fi

# --- attach it to the BMC as an NFS virtual CD -------------------------------
[ -n "$BMC_HOST" ]   || die "--bmc-host is required (or \$BMC_HOST)"
[ -n "$NFS_SERVER" ] || die "no --nfs-server and \$LAVA_DISPATCHER_IP is unset"
[ -n "$NFS_PATH" ]   || die "no --nfs-path and it could not be derived"
[ -f "$ISO_PATH" ]   || die "ISO not present: $ISO_PATH"
command -v curl >/dev/null 2>&1 || die "missing dependency: curl"

B="https://${BMC_HOST}"
CJ="$WORK/cj"
CURL=(curl -sk --max-time 30)

# A BMC that has just had its power restored answers pings, and even serves the
# web UI, well before its session backend will grant a login, so --wait-ready
# retries rather than failing the deploy on a BMC that is merely still booting.
bmc_login() {
    resp="$("${CURL[@]}" -c "$CJ" -X POST "$B/api/session" \
        --data-urlencode "username=${BMC_USER}" \
        --data-urlencode "password=${BMC_PASS}" 2>/dev/null || true)"
    TOKEN="$(printf '%s' "$resp" | sed -n 's/.*"CSRFToken"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    [ -n "$TOKEN" ]
}

deadline=$(( $(date +%s) + WAIT_READY ))
until bmc_login; do
    [ "$(date +%s)" -lt "$deadline" ] || die "BMC login failed (no CSRFToken in response)"
    log "BMC not ready, retrying login"
    sleep 5
done
auth=(-b "$CJ" -H "X-CSRFTOKEN: $TOKEN")
logout() { "${CURL[@]}" "${auth[@]}" -X DELETE "$B/api/session" >/dev/null 2>&1 || true; }
trap 'logout; rm -rf "$WORK"' EXIT

# Stop any existing CD redirection before re-pointing the share (ignore errors).
"${CURL[@]}" "${auth[@]}" -X POST "$B/api/settings/media/remote/stop-media" \
    -H 'Content-Type: application/json' \
    -d '{"image_type":1,"image_index":0}' >/dev/null 2>&1 || true

# Point the general media config at our NFS share as the CD source.
"${CURL[@]}" "${auth[@]}" -X PUT "$B/api/settings/media/general" \
    -H 'Content-Type: application/json' -d @- >/dev/null <<JSON
{
  "id": 1, "local_media_support": 0, "remote_media_support": 1, "same_settings": 0,
  "cd_remote_server_address": "${NFS_SERVER}", "cd_remote_source_path": "${NFS_PATH}",
  "cd_remote_share_type": "nfs", "cd_remote_domain_name": "", "cd_remote_user_name": "",
  "mount_cd": 1, "mount_fd": 0,
  "fd_remote_server_address": "", "fd_remote_source_path": "", "fd_remote_share_type": "",
  "fd_remote_domain_name": "", "fd_remote_user_name": "",
  "mount_hd": 0, "hd_remote_server_address": "", "hd_remote_source_path": "",
  "hd_remote_share_type": "", "hd_remote_domain_name": "", "hd_remote_user_name": ""
}
JSON

# Start redirection of our ISO as the virtual CD.
"${CURL[@]}" "${auth[@]}" -X POST "$B/api/settings/media/remote/start-media" \
    -H 'Content-Type: application/json' \
    -d "{\"image_name\":\"${IMAGE_NAME}\",\"image_type\":1,\"image_index\":0}" >/dev/null \
    || die "BMC start-media failed"

log "BMC ${BMC_HOST} redirecting nfs://${NFS_SERVER}${NFS_PATH}/${IMAGE_NAME} as virtual CD"
